# === Ma'lumotlar bazasi ===
DATABASE_URL=postgresql+asyncpg://dalabozor:dalabozor@localhost:5440/dalabozor

# === Ilova ===
APP_NAME=DalaBozor API
ENV=dev                       # dev | prod
API_V1_PREFIX=/api/v1
DEBUG=true

# === JWT ===
JWT_SECRET=CHANGE_ME_super_secret_key_min_32_chars_long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# === Karta shifrlash (Fernet kaliti — `python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"`) ===
CARD_ENCRYPTION_KEY=CHANGE_ME_generate_a_fernet_key

# === OTP ===
OTP_EXPIRE_SECONDS=120
OTP_LENGTH=4
OTP_DEV_CODE=1111             # dev'da doim shu kod qabul qilinadi (bo'sh qoldirsa — real random)

# === Narx koridori ===
CORRIDOR_PERCENT=10           # kechagi o'rtacha ±%

# === SMS (Eskiz — prod) ===
SMS_PROVIDER=mock             # mock | eskiz
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546

# === To'lov (Payme/Click — prod) ===
PAYMENT_PROVIDER=mock         # mock | payme | click
PAYME_MERCHANT_ID=
PAYME_KEY=
CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_SECRET=

# === Cron (soat, 24h) ===
ALLOCATION_HOUR=21
PAYOUT_HOUR=12
SCHEDULER_ENABLED=true

# Telegram bot ishonchli login siri (bot bilan bir xil bo\lsin)
BOT_API_SECRET=dalabozor-bot-2026-secret

BOT_TOKEN=

# === AI yordamchi (faqat backend, NEXT_PUBLIC_* ga qo'ymang) ===
# Groq Console'dan olingan server kaliti. Kalitlarni git'ga commit qilmang.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

# Provider timeout va yuklama limitlari
AI_REQUEST_TIMEOUT_SECONDS=30
AI_CHAT_MAX_OUTPUT_TOKENS=900
